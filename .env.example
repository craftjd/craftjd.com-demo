# Default for new clones (brochure / flat-file).
# App tier: cp .env.app.example .env
# Brochure:  cp .env.flat-file.example .env  (same as this file)

# -----------------------------------------------------------------------------
# Client — change per site
# -----------------------------------------------------------------------------

APP_NAME=Laravel
APP_URL=http://localhost

# Main site fulfillment webhook (must match craftjd.com JOES_WEBHOOK_SECRET).
# Local: http://localhost/api/joes/requests (Sail rewrites localhost → host.docker.internal).
# MAIN_SITE_WEBHOOK_URL=https://craftjd.com/api/joes/requests
# JOES_WEBHOOK_SECRET=
# JOES_LOCAL_DEPLOY_BYPASS_GIT=true
# JOES_BIN_PHP=1

SITE_DESCRIPTION="Drinkable Coffee."
CONTACT_EMAIL=you@example.com
GA_MEASUREMENT_ID=

# Sail + Mailhog (local). Use MAIL_HOST=mailhog inside containers — not 127.0.0.1.
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Without Sail: MAIL_MAILER=log

# -----------------------------------------------------------------------------
# Sail (local Docker)
# -----------------------------------------------------------------------------

WWWGROUP=1000
WWWUSER=1000
APP_PORT=80
VITE_PORT=5173
FORWARD_MAILHOG_DASHBOARD_PORT=8025

# -----------------------------------------------------------------------------
# Environment — local vs production
# -----------------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Production only — enables GET /health for hub monitoring
# MONITOR_KEY=

# Uncomment to override defaults:
# DEPLOY_BRANCH=main
# CHECK_URL=http://127.0.0.1

# -----------------------------------------------------------------------------
# Platform — flat-file defaults (rarely change)
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
