# Default for new clones (brochure / flat-file).
# App tier: cp .env.app.example .env
# Brochure:  cp .env.flat-file.example .env  (same as this file)

# -----------------------------------------------------------------------------
# Client — change per site
# -----------------------------------------------------------------------------

APP_NAME=Laravel
APP_URL=http://localhost

SITE_DESCRIPTION=
CONTACT_EMAIL=
GA_MEASUREMENT_ID=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls

# -----------------------------------------------------------------------------
# Environment — local vs production
# -----------------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
APP_KEY=

# -----------------------------------------------------------------------------
# Platform — flat-file defaults (rarely change)
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
