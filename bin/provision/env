#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../lib.sh" ]]; then
    BIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
else
    BIN_ROOT="${SCRIPT_DIR}"
fi
source "${BIN_ROOT}/lib.sh"

CMD=""
CONFIRM_YES=false
WEB_ROOT="/var/www"

usage() {
    cat <<'EOF'
Usage: env push|check|show [options]

Sync client .conf values into the site .env on the server.

  push   Apply env vars from the client config (shows diff and confirms if .env exists)
  check  Validate client config and server .env
  show   Print server .env with secrets redacted

Options:
  --yes, -y   Skip confirmation on push (non-interactive)

CONF_FILE defaults to bin/provision/clients/site.conf.
EOF
}

# First positional arg: subcommand (push|check|show)
CMD="${1:-}"
[[ -n "$CMD" ]] || { usage; exit 1; }
case "$CMD" in
    push | check | show) shift ;;
    -h | --help) usage; exit 0 ;;
    *) fail "unknown command: $1 (use push, check, or show)" ;;
esac

# Second positional arg: conf path (default: site.conf)
CONF_FILE="${1:-${BIN_ROOT}/provision/clients/site.conf}"
[[ -f "$CONF_FILE" ]] || fail "missing config: ${CONF_FILE}"
shift 2>/dev/null || true

# shellcheck disable=SC1090
source "$CONF_FILE"

[[ -n "${DOMAIN:-}" ]] || fail "config must set DOMAIN"

# Remaining flags: --yes only
while [[ $# -gt 0 ]]; do
    case "$1" in
        --yes | -y) CONFIRM_YES=true ;;
        -h | --help) usage; exit 0 ;;
        *) fail "unknown argument: $1 (try --help)" ;;
    esac
    shift
done

validate_tier "${TIER:-flat-file}"

SITE_DIR="$(site_deploy_root)"
ENV_FILE="$(site_env_file "$SITE_DIR")"
LIVE_DIR="$(site_live_path "$SITE_DIR")"

cmd_push() {
    [[ -f "$ENV_FILE" ]] || fail "missing ${ENV_FILE} — run provision/site first"

    declare -A DESIRED=()
    client_env_collect_desired DESIRED

    local change_count
    change_count="$(client_env_count_changes "$ENV_FILE" DESIRED)"

    if [[ "$change_count" -eq 0 ]]; then
        ok "no changes — .env already matches client config"
        return 0
    fi

    echo
    echo "Changes to ${ENV_FILE} (${change_count} key(s)):"
    echo
    client_env_print_diff "$ENV_FILE" DESIRED
    echo

    if ! client_env_confirm_push "$CONFIRM_YES"; then
        fail "aborted"
    fi

    client_env_apply_to_file "$ENV_FILE" DESIRED

    ok "updated ${change_count} key(s) in .env"

    if [[ -f "${LIVE_DIR}/artisan" ]]; then
        ok "refreshing Laravel config cache"
        (cd "$LIVE_DIR" && php artisan config:clear --no-ansi -q && php artisan config:cache --no-ansi -q)
    fi

    echo
    echo "Next:"
    echo "  cd ${LIVE_DIR}"
    echo "  ./bin/check"
}

cmd_check() {
    client_env_validate_config

    if [[ ! -f "$ENV_FILE" ]]; then
        fail "missing ${ENV_FILE} — run provision/site first"
    fi

    declare -A DESIRED=()
    client_env_collect_desired DESIRED

    local key value
    for key in $(client_env_sorted_keys DESIRED); do
        value="$(load_env_var "$key" "$ENV_FILE")"
        [[ -n "$value" ]] || fail "${key} is not set in .env (run: ./bin/remote env push)"
        ok "${key}"
    done

    value="$(load_env_var APP_KEY "$ENV_FILE")"
    [[ -n "$value" ]] || fail "APP_KEY is not set in .env"
    ok "APP_KEY"

    value="$(load_env_var MONITOR_KEY "$ENV_FILE")"
    if [[ -z "$value" && -z "${MONITOR_KEY:-}" ]]; then
        warn "MONITOR_KEY is not set in .env or client config"
    else
        ok "MONITOR_KEY"
    fi

    if [[ "$(load_env_var MAIL_MAILER "$ENV_FILE")" == "smtp" ]]; then
        [[ -n "$(load_env_var MAIL_HOST "$ENV_FILE")" ]] || fail "MAIL_HOST is not set (smtp)"
        ok "MAIL_HOST"
    elif [[ "$(load_env_var MAIL_MAILER "$ENV_FILE")" == "log" ]]; then
        warn "MAIL_MAILER=log — contact form logs to storage/logs (set smtp before go-live)"
    fi

    client_env_validate_mail_domain "$ENV_FILE"
    ok "env check passed"
}

cmd_show() {
    [[ -f "$ENV_FILE" ]] || fail "missing ${ENV_FILE}"

    echo "# ${ENV_FILE}"
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^([A-Z0-9_]+)=(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"
            if client_env_is_secret "$key"; then
                value="$(load_env_var "$key" "$ENV_FILE")"
                if [[ -n "$value" ]]; then
                    echo "${key}=***"
                else
                    echo "${key}="
                fi
            else
                echo "$line"
            fi
        else
            echo "$line"
        fi
    done <"$ENV_FILE"
}

case "$CMD" in
    push) cmd_push ;;
    check) cmd_check ;;
    show) cmd_show ;;
esac
