#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

source "$ROOT/bin/lib.sh"

echo "==> deploy"

require_command git
require_command php
require_command composer
require_command npm

BRANCH="${DEPLOY_BRANCH:-main}"

ok "pulling ${BRANCH}"
git pull origin "$BRANCH"

ok "composer install"
composer install --no-dev --optimize-autoloader --no-interaction

ok "npm build"
if [[ -f package-lock.json ]]; then
    npm ci
else
    warn "no package-lock.json — run npm install (commit the lockfile for reproducible deploys)"
    npm install
fi
npm run build

ok "artisan migrate"
php artisan migrate --force

ok "artisan cache"
php artisan config:cache
php artisan route:cache
php artisan view:cache

mkdir -p storage/app

GIT_SHA="$(git rev-parse HEAD)"
GIT_COMMIT_MESSAGE="$(git log -1 --format=%B HEAD)"
DEPLOYED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
REQUEST_ID="${REQUEST_ID:-}"

if [[ -n "$REQUEST_ID" && ! "$REQUEST_ID" =~ ^[0-9]+$ ]]; then
    fail "REQUEST_ID must be a positive integer (got: ${REQUEST_ID})"
fi

export GIT_SHA GIT_COMMIT_MESSAGE DEPLOYED_AT REQUEST_ID
write_deploy_meta_json storage/app/deploy-meta.json

if [[ -n "$REQUEST_ID" ]]; then
    ok "recording deploy for claim #${REQUEST_ID} (${GIT_SHA:0:7})"
    php artisan joes:record-deploy "$REQUEST_ID" "$GIT_SHA" "$DEPLOYED_AT"
else
    ok "deploy meta written (${GIT_SHA:0:7})"
fi

echo "Deploy complete. Run: ./bin/check"
