#!/usr/bin/env bash
set -euo pipefail

BIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$(cd "${BIN_ROOT}/.." && pwd)"
cd "$ROOT"

source "${BIN_ROOT}/lib.sh"

CONTACT_EMAIL="$(load_env_var CONTACT_EMAIL)"
MAIL_MAILER="$(load_env_var MAIL_MAILER)"

[[ -n "$CONTACT_EMAIL" ]] || fail "CONTACT_EMAIL is not set"
ok "CONTACT_EMAIL"

if [[ "$MAIL_MAILER" == "smtp" ]]; then
    [[ -n "$(load_env_var MAIL_HOST)" ]] || fail "MAIL_HOST is not set (smtp)"
    ok "MAIL_HOST"
fi

ok "MAIL_MAILER=${MAIL_MAILER}"
