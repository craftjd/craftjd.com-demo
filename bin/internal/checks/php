#!/usr/bin/env bash
set -euo pipefail

BIN_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(cd "${BIN_ROOT}/.." && pwd)"
cd "$ROOT"

source "${BIN_ROOT}/lib.sh"

php_bin() {
    if command -v php8.3 >/dev/null 2>&1; then
        echo php8.3
    else
        echo php
    fi
}

PHP="$(php_bin)"

PHP_VERSION="$("$PHP" -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')"
PHP_MAJOR="$("$PHP" -r 'echo PHP_MAJOR_VERSION;')"
PHP_MINOR="$("$PHP" -r 'echo PHP_MINOR_VERSION;')"

if (( PHP_MAJOR < 8 || (PHP_MAJOR == 8 && PHP_MINOR < 3) )); then
    fail "PHP 8.3+ required (found ${PHP_VERSION} via ${PHP})"
fi
ok "PHP ${PHP_VERSION} (${PHP})"

has_extension() {
    "$PHP" -r "exit(extension_loaded('${1}') ? 0 : 1);"
}

REQUIRED=(mbstring xml curl zip openssl tokenizer pdo fileinfo)

DB_CONNECTION="$(load_env_var DB_CONNECTION)"
case "$DB_CONNECTION" in
    sqlite) REQUIRED+=(pdo_sqlite) ;;
    mysql) REQUIRED+=(pdo_mysql) ;;
esac

if [[ "$(load_env_var CACHE_STORE)" == "redis" || "$(load_env_var SESSION_DRIVER)" == "redis" || "$(load_env_var QUEUE_CONNECTION)" == "redis" ]]; then
    REQUIRED+=(redis)
fi

MISSING=()
for ext in "${REQUIRED[@]}"; do
    if has_extension "$ext"; then
        ok "extension ${ext}"
    else
        MISSING+=("$ext")
    fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
    echo "  php binary: $(command -v "$PHP") → $("$PHP" --ini | head -1)" >&2
    if command -v php >/dev/null 2>&1 && command -v php8.3 >/dev/null 2>&1; then
        echo "  php:       $(readlink -f "$(command -v php)")" >&2
        echo "  php8.3:    $(readlink -f "$(command -v php8.3)")" >&2
    fi
    echo "  installed modules (${PHP}):" >&2
    "$PHP" -m | sed 's/^/         /' >&2
    echo "  fix (Ubuntu):" >&2
    echo "    sudo phpenmod -v 8.3 mbstring xml curl zip sqlite3 mysql" >&2
    echo "    sudo update-alternatives --set php /usr/bin/php8.3" >&2
    echo "    sudo systemctl reload php8.3-fpm" >&2
    fail "missing PHP extension(s): ${MISSING[*]}"
fi

if command -v systemctl >/dev/null 2>&1; then
    for unit in php8.3-fpm php8.4-fpm php-fpm; do
        if systemctl is-active --quiet "${unit}" 2>/dev/null; then
            ok "php-fpm (${unit})"
            exit 0
        fi
    done
    echo "  warn  php-fpm service not detected (skip if not using systemd)"
fi
