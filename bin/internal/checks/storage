#!/usr/bin/env bash
set -euo pipefail

BIN_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(cd "${BIN_ROOT}/.." && pwd)"
cd "$ROOT"

source "${BIN_ROOT}/lib.sh"

[[ -w storage ]] || fail "storage is not writable"
ok "storage writable"

[[ -w bootstrap/cache ]] || fail "bootstrap/cache is not writable"
ok "bootstrap/cache writable"

# Runtime private dir (uploads, etc.) — brochure JSON lives in resources/content/data
PRIVATE_DIR="storage/app/private"
if [[ -d "$PRIVATE_DIR" ]]; then
    [[ -w "$PRIVATE_DIR" ]] || fail "${PRIVATE_DIR} is not writable"
    ok "${PRIVATE_DIR} writable"
fi
