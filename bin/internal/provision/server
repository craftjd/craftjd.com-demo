#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../lib.sh" ]]; then
    BIN_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
else
    BIN_ROOT="${SCRIPT_DIR}"
fi
source "${BIN_ROOT}/lib.sh"

# Read config from .conf file (default: site.conf, override with a conf path).
CONF_FILE="${1:-${BIN_ROOT}/internal/provision/clients/site.conf}"

[[ -f "$CONF_FILE" ]] || fail "missing config: ${CONF_FILE}"
# shellcheck disable=SC1090
source "$CONF_FILE"
shift 2>/dev/null || true   # consume the conf path arg

confirm_destructive "Provision server: install packages, create deploy user, configure nginx/php/fail2ban/UFW" "${CONFIRM:-false}"

[[ -n "${TIER:-}" ]] || fail "config must set TIER"
validate_tier "$TIER"

usage() {
    cat <<'EOF'
Usage: server [CONF_FILE]

One-time VPS setup (Ubuntu 24.04). Run as root on a fresh Linode, or with sudo.
Reads TIER from the given .conf file (default: bin/provision/clients/site.conf).
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help) usage; exit 0 ;;
        *) fail "unknown argument: $1" ;;
    esac
    shift
done

[[ -n "$TIER" ]] || { usage; exit 1; }
validate_tier "$TIER"

if [[ "${EUID}" -ne 0 ]] && ! sudo -n true 2>/dev/null; then
    fail "run as root or as a user with passwordless sudo"
fi

echo "==> provision server (tier=${TIER})"

if [[ "${EUID}" -eq 0 ]] && ! id deploy &>/dev/null; then
    ok "creating deploy user"
    adduser --disabled-password --gecos "" deploy
    usermod -aG sudo deploy
fi

if [[ "${EUID}" -eq 0 ]]; then
    sync_deploy_ssh_keys || true
    configure_deploy_sudo
elif id deploy &>/dev/null; then
    ok "deploy user exists (run as root to sync SSH keys)"
fi

ok "apt update"
sudo_cmd apt-get update -qq
sudo_cmd DEBIAN_FRONTEND=noninteractive apt-get upgrade -y -qq

PACKAGES=(nginx git unzip curl software-properties-common sqlite3)

ok "installing base packages"
sudo_cmd DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${PACKAGES[@]}"

PHP_PACKAGES=(
    php8.3-fpm php8.3-cli php8.3-mbstring php8.3-xml php8.3-curl
    php8.3-zip php8.3-sqlite3 php8.3-mysql
)

if [[ "$TIER" == "app" ]]; then
    PHP_PACKAGES+=(php8.3-redis)
fi

ok "installing PHP 8.3"
sudo_cmd DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${PHP_PACKAGES[@]}"

PHP_MODS=(mbstring xml curl zip sqlite3 mysql)
if [[ "$TIER" == "app" ]]; then
    PHP_MODS+=(redis)
fi

ok "enabling PHP 8.3 modules"
for mod in "${PHP_MODS[@]}"; do
    sudo_cmd phpenmod -v 8.3 "$mod" 2>/dev/null || true
done

if [[ -x /usr/bin/php8.3 ]] && command -v update-alternatives >/dev/null 2>&1; then
    sudo_cmd update-alternatives --set php /usr/bin/php8.3 2>/dev/null || true
fi

sudo_cmd systemctl restart php8.3-fpm

if [[ "$TIER" == "app" ]]; then
    ok "installing Redis and MySQL"
    sudo_cmd DEBIAN_FRONTEND=noninteractive apt-get install -y -qq redis-server mysql-server
    sudo_cmd systemctl enable --now redis-server mysql
fi

if ! command -v composer >/dev/null 2>&1; then
    ok "installing Composer"
    curl -sS https://getcomposer.org/installer | php
    sudo_cmd mv composer.phar /usr/local/bin/composer
else
    ok "Composer already installed"
fi

if ! command -v node >/dev/null 2>&1 || [[ "$(node -v | cut -d. -f1 | tr -d v)" -lt 18 ]]; then
    ok "installing Node.js 20"
    if [[ "${EUID}" -eq 0 ]]; then
        curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    else
        curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -
    fi
    sudo_cmd DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nodejs
else
    ok "Node.js already installed"
fi

if ! command -v certbot >/dev/null 2>&1; then
    ok "installing Certbot"
    sudo_cmd DEBIAN_FRONTEND=noninteractive apt-get install -y -qq certbot python3-certbot-nginx
else
    ok "Certbot already installed"
fi

ok "configuring /var/www"
sudo_cmd mkdir -p /var/www
if id deploy &>/dev/null; then
    sudo_cmd chown deploy:deploy /var/www
fi

if command -v ufw >/dev/null 2>&1; then
    ok "configuring UFW"
    sudo_cmd ufw allow OpenSSH
    sudo_cmd ufw allow 'Nginx Full'
    if ! sudo_cmd ufw status | grep -q "Status: active"; then
        sudo_cmd ufw --force enable
    fi
fi

sudo_cmd systemctl enable --now nginx php8.3-fpm

if [[ -f /etc/nginx/sites-enabled/default ]]; then
    ok "removing nginx default site"
    sudo_cmd rm -f /etc/nginx/sites-enabled/default
    sudo_cmd systemctl reload nginx
fi

echo
echo "Server ready."
if [[ ! -s /home/deploy/.ssh/authorized_keys ]] 2>/dev/null; then
    echo "  !  deploy SSH keys missing — fix keys (see warnings above), then re-run."
    echo
fi

if [[ "${INVOKED_VIA_REMOTE:-}" != 1 ]]; then
    echo "From your laptop:"
    echo "  ./bin/remote github-key   # private GitHub repos"
    echo "  ./bin/remote site"
    if [[ "$TIER" == "app" ]]; then
        echo
        echo "App tier: set DB_NAME, DB_USER, DB_PASS in the client config."
    fi
fi
