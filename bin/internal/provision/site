#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../lib.sh" ]]; then
    BIN_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
else
    BIN_ROOT="${SCRIPT_DIR}"
fi
source "${BIN_ROOT}/lib.sh"

# Read config from .conf file (default: site.conf, override with a conf path).
CONF_FILE="${1:-${BIN_ROOT}/internal/provision/clients/site.conf}"

[[ -f "$CONF_FILE" ]] || fail "missing config: ${CONF_FILE}"
# shellcheck disable=SC1090
source "$CONF_FILE"
shift || true   # consume the conf path arg; extra args (e.g. --fresh) remain in $@

require_sudo

[[ -n "${DOMAIN:-}" && -n "${REPO:-}" && -n "${TIER:-}" ]] || fail "config must set DOMAIN, REPO, and TIER"
validate_tier "${TIER}"

if [[ "${SSL:-false}" == true && -z "${CERT_EMAIL:-}" ]]; then
    fail "config: CERT_EMAIL is required when SSL=true"
fi

if [[ "$TIER" == "app" ]]; then
    if [[ -n "${DB_NAME:-}" || -n "${DB_USER:-}" || -n "${DB_PASS:-}" ]]; then
        [[ -n "${DB_NAME:-}" && -n "${DB_USER:-}" && -n "${DB_PASS:-}" ]] \
            || fail "app tier requires all of DB_NAME, DB_USER, DB_PASS in config"
    fi
fi

SITE_DIR="$(site_deploy_root)"
RELEASE_DIR="${SITE_DIR}/releases/1"
SHARED_ENV="$(site_env_file "$SITE_DIR")"
DOCUMENT_ROOT="${SITE_DIR}/current/public"

# Parse extra flags
SITE_FRESH=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --fresh) SITE_FRESH=true ;;
        *) break ;;
    esac
    shift
done

if [[ "$SITE_FRESH" == true && -d "$SITE_DIR" ]]; then
    echo "==> fresh provision (tier=${TIER}, domain=${DOMAIN}, config=${CONF_FILE})"
    echo "  -> found existing site at ${SITE_DIR}"
    confirm_destructive "Wipe ${SITE_DIR} and provision from scratch (all data will be lost)" "${CONFIRM:-false}"
    sudo_cmd rm -rf "$SITE_DIR"
    UPDATE_MODE=false
elif [[ -d "$SITE_DIR" ]]; then
    UPDATE_MODE=true
    echo "==> re-provision site (tier=${TIER}, domain=${DOMAIN}, config=${CONF_FILE})"
    echo "  -> found existing site at ${SITE_DIR}"
    echo "  -> running in update mode: nginx, certbot, permissions, .env (current release untouched)"
    confirm_destructive "Re-provision ${DOMAIN}: nginx config, certbot, permissions, .env sync" "${CONFIRM:-false}"
else
    UPDATE_MODE=false
    echo "==> provision site (tier=${TIER}, domain=${DOMAIN}, config=${CONF_FILE})"
fi

if [[ ! -d "$WEB_ROOT" ]]; then
    fail "${WEB_ROOT} missing — run provision server first"
fi

# ─────────────────────────────────────────────────────────────────────────────
#  First-time setup: directory structure, clone, seed, build
# ─────────────────────────────────────────────────────────────────────────────
if [[ "$UPDATE_MODE" == false ]]; then
    mkdir -p "${SITE_DIR}/releases" "${SITE_DIR}/shared" "${SITE_DIR}/.dep" "${SITE_DIR}/shared/database"

    CLONE_URL="$(github_repo_clone_url "$REPO" "$DOMAIN")"
    require_github_repo_access "$REPO"

    ok "cloning ${CLONE_URL} → releases/1"
    if ! GIT_TERMINAL_PROMPT=0 git clone "$CLONE_URL" "$RELEASE_DIR"; then
        fail "git clone failed — add the deploy key to the GitHub repo first (Settings > Deploy keys), then re-run"
    fi
    cd "$RELEASE_DIR"

    ENV_TEMPLATE=".env.flat-file.example"
    if [[ "$TIER" == "app" ]]; then
        ENV_TEMPLATE=".env.app.example"
    fi

    [[ -f "$ENV_TEMPLATE" ]] || fail "missing ${ENV_TEMPLATE} in repo"
    cp "$ENV_TEMPLATE" "$SHARED_ENV"

    APP_URL="https://${DOMAIN}"
    if [[ "${SSL:-false}" != true ]]; then
        APP_URL="http://${DOMAIN}"
    fi

    MONITOR_KEY="$(php -r 'echo bin2hex(random_bytes(16));')"

    set_env_var APP_URL "$APP_URL" "$SHARED_ENV"
    set_env_var MONITOR_KEY "$MONITOR_KEY" "$SHARED_ENV"

    ok "syncing shared/.env from client config"
    declare -A DESIRED=()
    client_env_collect_desired DESIRED
    client_env_apply_to_file "$SHARED_ENV" DESIRED

    ln -sfn ../../shared/.env .env

    ok "composer install"
    composer install --no-dev --optimize-autoloader --no-interaction

    if [[ "$TIER" == "app" && -n "${DB_NAME:-}" ]]; then
        ok "creating MySQL database ${DB_NAME}"
        sudo_cmd mysql -e "CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
        sudo_cmd mysql -e "CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASS}';"
        sudo_cmd mysql -e "GRANT ALL ON \`${DB_NAME}\`.* TO '${DB_USER}'@'localhost';"
        sudo_cmd mysql -e "FLUSH PRIVILEGES;"
        set_env_var DB_DATABASE "$DB_NAME" "$SHARED_ENV"
        set_env_var DB_USERNAME "$DB_USER" "$SHARED_ENV"
        set_env_var DB_PASSWORD "$DB_PASS" "$SHARED_ENV"
    fi

    if [[ "$TIER" == "flat-file" ]]; then
        ok "creating SQLite database (shared)"
        touch "${SITE_DIR}/shared/database/database.sqlite"
        mkdir -p database
        ln -sfn ../../shared/database/database.sqlite database/database.sqlite
    fi

    ok "generating APP_KEY"
    php artisan key:generate --force

    deployer_adopt_release "$SITE_DIR" "$RELEASE_DIR" "$TIER"

    # First-time cleanup: remove conflicting Deployer artifacts so it can
    # create releases/1 cleanly on the first deploy (task deploy).
    ok "cleaning up deployer artifacts for first deploy"
    rm -rf "$RELEASE_DIR" "${SITE_DIR}/current" "${SITE_DIR}/.dep/releases" "${SITE_DIR}/.dep/metadata"

# ─────────────────────────────────────────────────────────────────────────────
#  Update mode: ensure shared dirs exist, no destructive steps
# ─────────────────────────────────────────────────────────────────────────────
else
    # Ensure Deployer layout directories exist
    mkdir -p "${SITE_DIR}/releases" "${SITE_DIR}/shared" "${SITE_DIR}/.dep" "${SITE_DIR}/shared/database"
    if [[ -f "${SITE_DIR}/shared/storage/app/deploy-meta.json" ]]; then
        ok "site appears active (current → $(readlink "${SITE_DIR}/current"))"
    fi

    # Re-sync shared/.env from client config (preserving APP_KEY and MONITOR_KEY)
    if [[ -f "$SHARED_ENV" ]]; then
        APP_KEY="$(load_env_var APP_KEY "$SHARED_ENV")"
        MONITOR_KEY="$(load_env_var MONITOR_KEY "$SHARED_ENV")"
    fi
    declare -A DESIRED=()
    client_env_collect_desired DESIRED
    client_env_apply_to_file "$SHARED_ENV" DESIRED
    # Re-apply keys that provision/site generates (not in client config)
    [[ -n "${APP_KEY:-}" ]] && set_env_var APP_KEY "$APP_KEY" "$SHARED_ENV"
    [[ -n "${MONITOR_KEY:-}" ]] && set_env_var MONITOR_KEY "$MONITOR_KEY" "$SHARED_ENV"

    # Ensure SQLite database exists
    if [[ "$TIER" == "flat-file" && ! -f "${SITE_DIR}/shared/database/database.sqlite" ]]; then
        ok "creating missing SQLite database"
        touch "${SITE_DIR}/shared/database/database.sqlite"
    fi
fi

# ─────────────────────────────────────────────────────────────────────────────
#  Idempotent: always run (safe during live serving)
# ─────────────────────────────────────────────────────────────────────────────
deployer_fix_permissions "$SITE_DIR"

if [[ -f "/etc/nginx/sites-available/${DOMAIN}" ]]; then
    nginx_update_document_root "$DOMAIN" "$SITE_DIR"
else
    nginx_write_site_config "$DOMAIN" "$DOCUMENT_ROOT"
fi

if [[ "${SSL:-false}" == true ]]; then
    certbot_args=()
    while read -r name; do
        [[ -n "$name" ]] && certbot_args+=(-d "$name")
    done < <(site_certbot_domains "$DOMAIN" | tr ' ' '\n')

    TLS_LABEL="$(site_certbot_domains "$DOMAIN")"
    ok "requesting TLS certificate (${TLS_LABEL})"
    sudo_cmd certbot --nginx \
        "${certbot_args[@]}" \
        --non-interactive --agree-tos -m "$CERT_EMAIL" \
        --redirect
    nginx_update_document_root "$DOMAIN" "$SITE_DIR"
fi

echo
if [[ "$UPDATE_MODE" == true ]]; then
    echo "Site re-provisioned (${SITE_DIR})"
    echo "  nginx config, certbot, permissions, .env, and shared dirs refreshed."
    echo "  Current release was not modified — run task deploy to publish code changes."
else
    echo "Site scaffolded at ${SITE_DIR} (Deployer layout)"
    echo "MONITOR_KEY=${MONITOR_KEY}"
    echo
    echo "Next:"
    echo "  task deploy              # first atomic deploy"
fi
