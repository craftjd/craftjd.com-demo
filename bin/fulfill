#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${BIN_ROOT}/lib.sh"

cd "$ROOT"

require_command php

usage() {
    echo "Usage:" >&2
    echo "  ./bin/fulfill REQUEST_ID \"summary of changes\"" >&2
    echo >&2
    echo "Workflow:" >&2
    echo "  1. Open the claim link from the main-site email (or: php artisan joes:claim REQUEST_ID)" >&2
    echo "  2. Edit Joe's Cafe, then REQUEST_ID=42 ./bin/deploy" >&2
    echo "  3. Verify the live site, then ./bin/fulfill 42 \"Updated summer hours.\"" >&2
    exit 1
}

REQUEST_ID="${1:-}"
SUMMARY="${2:-}"

if [[ -z "$REQUEST_ID" || -z "$SUMMARY" ]]; then
    usage
fi

echo "==> fulfill #${REQUEST_ID}"
php artisan joes:fulfill "$REQUEST_ID" "$SUMMARY"
