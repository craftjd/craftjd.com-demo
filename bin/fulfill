#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${BIN_ROOT}/lib.sh"

cd "$ROOT"

require_command php

usage() {
    echo "Usage:" >&2
    echo "  ./bin/fulfill start REQUEST_ID" >&2
    echo "  ./bin/fulfill REQUEST_ID \"summary of changes\"" >&2
    echo >&2
    echo "Workflow:" >&2
    echo "  1. ./bin/fulfill start 42" >&2
    echo "  2. Edit the sample site, then REQUEST_ID=42 ./bin/deploy" >&2
    echo "  3. Verify the live site, then ./bin/fulfill 42 \"Updated summer hours.\"" >&2
    exit 1
}

ACTION="${1:-}"

if [[ -z "$ACTION" ]]; then
    usage
fi

if [[ "$ACTION" == "start" ]]; then
    REQUEST_ID="${2:-}"

    if [[ -z "$REQUEST_ID" ]]; then
        usage
    fi

    echo "==> fulfill start #${REQUEST_ID}"
    php artisan sample:claim "$REQUEST_ID"
    exit 0
fi

REQUEST_ID="$ACTION"
SUMMARY="${2:-}"

if [[ -z "$SUMMARY" ]]; then
    usage
fi

echo "==> fulfill #${REQUEST_ID}"
php artisan sample:fulfill "$REQUEST_ID" "$SUMMARY"
