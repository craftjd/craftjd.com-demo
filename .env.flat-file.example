# Brochure / flat-file sites (SQLite, no Redis).
# Copy: cp .env.flat-file.example .env

# -----------------------------------------------------------------------------
# Client — change per site
# -----------------------------------------------------------------------------

APP_NAME=
APP_URL=https://example.com

SITE_DESCRIPTION=
CONTACT_EMAIL=
GA_MEASUREMENT_ID=

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls

# -----------------------------------------------------------------------------
# Environment — local vs production
# -----------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_KEY=

# -----------------------------------------------------------------------------
# Platform — flat-file defaults (rarely change)
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
