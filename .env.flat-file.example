# Brochure / flat-file sites (SQLite, no Redis).
# Copy: cp .env.flat-file.example .env

# -----------------------------------------------------------------------------
# Client — change per site
# -----------------------------------------------------------------------------

APP_NAME=
APP_URL=https://example.com

# Main site fulfillment webhook (must match craftjd.com JOES_WEBHOOK_SECRET).
# MAIN_SITE_WEBHOOK_URL=https://craftjd.com/api/joes/requests
# JOES_WEBHOOK_SECRET=

SITE_DESCRIPTION=
CONTACT_EMAIL=
GA_MEASUREMENT_ID=

# Log driver until SMTP is configured (contact form writes to storage/logs/laravel.log).
# Set MAIL_MAILER=smtp and fill MAIL_* below before go-live (or via client config + env push).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls

# -----------------------------------------------------------------------------
# Environment — local vs production
# -----------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_KEY=

MONITOR_KEY=

# Uncomment to override defaults:
# DEPLOY_BRANCH=main
# CHECK_URL=http://127.0.0.1

# -----------------------------------------------------------------------------
# Platform — flat-file defaults (rarely change)
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
